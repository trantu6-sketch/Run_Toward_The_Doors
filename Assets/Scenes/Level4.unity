  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ch\xE0o b\u1EA1n,\n\nL\u1EDDi \u0111\u1EA7u ti\xEAn, m\xECnh mu\u1ED1n
    g\u1EEDi l\u1EDDi c\u1EA3m \u01A1n ch\xE2n th\xE0nh nh\u1EA5t \u0111\u1EBFn b\u1EA1n
    v\xEC \u0111\xE3 d\xE0nh th\u1EDDi gian tr\u1EA3i nghi\u1EC7m t\u1EF1a game c\u1EE7a
    m\xECnh. S\u1EF1 \u1EE7ng h\u1ED9 v\xE0 ph\u1EA3n h\u1ED3i c\u1EE7a b\u1EA1n
    ch\xEDnh l\xE0 \u0111\u1ED9ng l\u1EF1c r\u1EA5t l\u1EDBn \u0111\u1EC3 m\xECnh
    ti\u1EBFp t\u1EE5c ho\xE0n thi\u1EC7n s\u1EA3n ph\u1EA9m n\xE0y.\nM\xECnh r\u1EA5t
    ti\u1EBFc ph\u1EA3i th\xF4ng b\xE1o r\u1EB1ng hi\u1EC7n t\u1EA1i tr\xF2 ch\u01A1i
    m\u1EDBi ch\u1EC9 ho\xE0n thi\u1EC7n \u0111\u1EBFn m\xE0n 3. N\u1ED9i dung cho
    m\xE0n 4 hi\u1EC7n v\u1EABn \u0111ang trong qu\xE1 tr\xECnh ph\xE1t tri\u1EC3n
    n\xEAn ch\u01B0a th\u1EC3 ra m\u1EAFt ngay l\xFAc n\xE0y.\nM\xECnh \u0111ang
    n\u1ED7 l\u1EF1c d\xE0nh th\u1EDDi gian \u0111\u1EC3 thi\u1EBFt k\u1EBF v\xE0
    ho\xE0n thi\u1EC7n c\xE1c m\xE0n ch\u01A1i ti\u1EBFp theo m\u1ED9t c\xE1ch ch\u1EC9n
    chu nh\u1EA5t. Hy v\u1ECDng b\u1EA1n s\u1EBD ti\u1EBFp t\u1EE5c ki\xEAn nh\u1EABn
    ch\u1EDD \u0111\u1EE3i v\xE0 \u0111\xF3n nh\u1EADn c\xE1c b\u1EA3n c\u1EADp nh\u1EADt
    m\u1EDBi trong th\u1EDDi gian t\u1EDBi.\nM\u1ED9t l\u1EA7n n\u1EEFa, c\u1EA3m
    \u01A1n b\u1EA1n r\u1EA5t nhi\u1EC1u v\xEC \u0111\xE3 ch\u01A1i game! N\u1EBFu
    c\xF3 g\xF3p \xFD n\xE0o, \u0111\u1EEBng ng\u1EA7n ng\u1EA1i chia s\u1EBB v\u1EDBi
    m\xECnh nh\xE9.\nCh\xFAc b\u1EA1n c\xF3 nh\u1EEFng gi\xE2y ph\xFAt gi\u1EA3i
    tr\xED th\u1EADt vui v\u1EBB!\nTr\xE2n tr\u1ECDng,\n[Tr\u1EA7n Anh T\xFA]"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7725f9c7e4c79524f969885eb1402211, type: 2}
